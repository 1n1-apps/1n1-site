<!DOCTYPE html>
<html lang="en-GB" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}1n1</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}1n1">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/brand/share-card.png">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="dark light">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" href="/assets/brand/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/archivo-1n1.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css">
<script>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
<script type="module" src="/assets/theme.js"></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<button class="theme" type="button" hidden>
<svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<mask id="theme-cut"><rect width="24" height="24" fill="#fff"/><circle class="cut" cx="21" cy="5" r="7" fill="#000"/></mask>
<circle class="disc" cx="12" cy="12" r="6" mask="url(#theme-cut)"/>
<g class="rays"><path d="M12 1.5v2.5M12 20v2.5M1.5 12h2.5M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g>
</svg>
<span class="sr" data-label></span>
</button>
<div class="page">
<header class="half{% if not home %} inner{% endif %}">
<div class="top">
<a class="brand" href="/">{% mark %}<span class="wm">1<i aria-hidden="true">·</i>n<i aria-hidden="true">·</i>1</span></a>
{% if home %}<h1 class="hl">{{ site.lead }}</h1>{% else %}<p class="hl">{{ site.lead }}</p>{% endif %}
<nav aria-label="Site">
<ul>
<li><a href="/apps/"{% if section == 'apps' %} aria-current="page"{% endif %}>Apps</a></li>
<li><a href="/contact/"{% if section == 'contact' %} aria-current="page"{% endif %}>Contact</a></li>
</ul>
</nav>
</div>
<p class="mail"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
</header>
<div class="divide" aria-hidden="true"></div>
<div class="col">
<main id="main" class="body">
{{ content | safe }}
</main>
<footer class="ft">
<p>© 2026 1n1</p>
<p><a href="/privacy/">Privacy policies</a></p>
<p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
</footer>
</div>
</div>
</body>
</html>
